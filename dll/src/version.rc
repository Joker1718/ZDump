// version.rc — Windows version resource for ZoltDumper.dll
// Uses ZOLT_VERSION defines from BuildInfo.h (generated by CMake)

#include <winresrc.h>
#include "BuildInfo.h"

// Ensure defaults if BuildInfo.h is not yet generated
#ifndef ZOLT_VERSION_MAJOR
#define ZOLT_VERSION_MAJOR 0
#endif
#ifndef ZOLT_VERSION_MINOR
#define ZOLT_VERSION_MINOR 0
#endif
#ifndef ZOLT_VERSION_PATCH
#define ZOLT_VERSION_PATCH 0
#endif
#ifndef ZOLT_VERSION_BUILD
#define ZOLT_VERSION_BUILD 0
#endif
#ifndef ZOLT_VERSION_STRING
#define ZOLT_VERSION_STRING "0.0.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    ZOLT_VERSION_MAJOR, ZOLT_VERSION_MINOR, ZOLT_VERSION_PATCH, ZOLT_VERSION_BUILD
    PRODUCTVERSION ZOLT_VERSION_MAJOR, ZOLT_VERSION_MINOR, ZOLT_VERSION_PATCH, ZOLT_VERSION_BUILD
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS      VS_FF_DEBUG
#else
    FILEFLAGS      0x0L
#endif
    FILEOS         VOS_NT_WINDOWS32
    FILETYPE       VFT_DLL
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Zolt-Dump"
            VALUE "FileDescription",  "Zolt-Dump Godot Engine Memory Dumper"
            VALUE "FileVersion",      ZOLT_VERSION_STRING
            VALUE "InternalName",     "ZoltDumper"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "ZoltDumper.dll"
            VALUE "ProductName",      "Zolt-Dump"
            VALUE "ProductVersion",   ZOLT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
