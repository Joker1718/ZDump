<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZoltDumpUI.ViewModels"
             x:Class="ZoltDumpUI.Views.InstanceFinderPanel"
             x:DataType="vm:InstanceFinderViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding FindInstancesCommand}" />
    </UserControl.KeyBindings>

    <DockPanel Background="#252526">
        <!-- Search Bar -->
        <Border DockPanel.Dock="Top" Padding="4" Background="#2D2D30">
            <StackPanel Spacing="4">
                <DockPanel>
                    <Button Content="Find" DockPanel.Dock="Right" Margin="4,0,0,0"
                            Command="{Binding FindInstancesCommand}" />
                    <CheckBox Content="Exact" DockPanel.Dock="Right" IsChecked="{Binding ExactMatch}"
                              Foreground="#D4D4D4" VerticalAlignment="Center" Margin="4,0" />
                    <TextBox x:Name="ClassNameBox" Text="{Binding SearchClassName}" PlaceholderText="Name or class..." />
                </DockPanel>
                <DockPanel>
                    <Button Content="Lookup" DockPanel.Dock="Right" Margin="4,0,0,0"
                            Command="{Binding FindByAddressCommand}" />
                    <TextBox x:Name="AddressBox" Text="{Binding AddressSearch}" PlaceholderText="Address lookup..."
                             FontFamily="Consolas" />
                </DockPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="#569CD6" FontSize="11"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </Border>

        <!-- Split: Instances + Fields -->
        <Grid RowDefinitions="*,4,*">
            <!-- Instances -->
            <DataGrid x:Name="InstancesGrid"
                      x:CompileBindings="False"
                      Grid.Row="0"
                      ItemsSource="{Binding Instances}"
                      SelectedItem="{Binding SelectedInstance}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserResizeColumns="True"
                      HorizontalScrollBarVisibility="Auto"
                      Background="#1E1E1E"
                      Foreground="#D4D4D4"
                      FontFamily="Consolas"
                      FontSize="12">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open in LiveWalker" Command="{Binding OpenInLiveWalkerCommand}"
                                  CommandParameter="{Binding $parent[DataGrid].SelectedItem}" />
                        <Separator />
                        <MenuItem Header="Copy Address" Command="{Binding CopyAddressCommand}"
                                  CommandParameter="{Binding $parent[DataGrid].SelectedItem}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="140" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                    <DataGridTextColumn Header="Class" Binding="{Binding ClassName}" Width="150" />
                    <DataGridTextColumn Header="Slot" Binding="{Binding SlotIndex}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="4" Background="#3F3F46" />

            <!-- Selected Instance Fields -->
            <DataGrid x:CompileBindings="False"
                      Grid.Row="2"
                      ItemsSource="{Binding SelectedFields}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserResizeColumns="True"
                      HorizontalScrollBarVisibility="Auto"
                      Background="#1E1E1E"
                      Foreground="#D4D4D4"
                      FontFamily="Consolas"
                      FontSize="12">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy CE XML" Command="{Binding CopyCeXmlCommand}" />
                        <MenuItem Header="Export SDK" Command="{Binding ExportSdkCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Offset" Binding="{Binding Offset, StringFormat='0x{0:X}'}" Width="70" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" />
                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="200" />
                    <DataGridTextColumn Header="Hex" Binding="{Binding Hex}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
