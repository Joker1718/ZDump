<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZoltDumpUI.ViewModels"
             x:Class="ZoltDumpUI.Views.LiveWalkerPanel"
             x:DataType="vm:LiveWalkerViewModel">

    <DockPanel Background="#252526">
        <!-- Toolbar Row 1 -->
        <Border DockPanel.Dock="Top" Padding="4" Background="#2D2D30">
            <WrapPanel>
                <Button Content="Start World" Command="{Binding StartWorldCommand}" Margin="0,0,4,0" />
                <Button Content="Back" Command="{Binding NavigateBackCommand}" Margin="0,0,4,0" />
                <Button Content="Parent" Command="{Binding NavigateToParentCommand}" Margin="0,0,4,0" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Separator Width="1" Background="#3F3F46" Margin="4,2" />
                <Button Content="Copy CE XML" Command="{Binding CopyCeXmlCommand}" Margin="0,0,4,0" FontSize="11" />
                <Button Content="Export CSX" Command="{Binding ExportCsxCommand}" Margin="0,0,4,0" FontSize="11" />
                <Button Content="Export SDK" Command="{Binding ExportSdkCommand}" Margin="0,0,8,0" FontSize="11" />
                <CheckBox Content="Auto" IsChecked="{Binding IsAutoRefresh}"
                          Foreground="#D4D4D4" VerticalAlignment="Center" Margin="4,0" />
                <NumericUpDown Value="{Binding AutoRefreshInterval}" Minimum="200" Maximum="10000"
                               Increment="100" Width="100" Margin="2,0" />
            </WrapPanel>
        </Border>

        <!-- Toolbar Row 2: Address -->
        <Border DockPanel.Dock="Top" Padding="4" Background="#2D2D30">
            <DockPanel>
                <Button Content="Go" DockPanel.Dock="Right" Command="{Binding GoToAddressCommand}"
                        Margin="4,0,0,0" />
                <TextBox x:Name="AddressBox" Text="{Binding AddressInput}" Watermark="Enter address..."
                         FontFamily="Consolas" />
            </DockPanel>
        </Border>

        <!-- Breadcrumbs (max 60px tall to prevent pushing fields DataGrid off-screen) -->
        <Border DockPanel.Dock="Top" Padding="4,2" Background="#252526"
                MaxHeight="60" ClipToBounds="True"
                IsVisible="{Binding Breadcrumbs.Count}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BreadcrumbItem">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding Display}" Classes="breadcrumb"
                                    Command="{Binding $parent[ItemsControl].((vm:LiveWalkerViewModel)DataContext).NavigateToBreadcrumbCommand}"
                                    CommandParameter="{Binding}"
                                    Foreground="#569CD6" Background="Transparent"
                                    Padding="4,2" FontSize="11" />
                            <TextBlock Text=">" Foreground="#808080" VerticalAlignment="Center"
                                       Margin="2,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Object Info Header -->
        <Border DockPanel.Dock="Top" Padding="8,4" Background="#1E1E1E">
            <StackPanel Spacing="2">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                        <Button Content="Copy Addr" Command="{Binding CopyAddressCommand}" FontSize="11" />
                        <Button Content="Copy Name" Command="{Binding CopyNameCommand}" FontSize="11" />
                        <Button Content="HEX" Command="{Binding NavigateHexViewCommand}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding CurrentClassName}" Foreground="#569CD6" FontWeight="Bold" />
                        <TextBlock Text="{Binding CurrentName}" Foreground="#D4D4D4" />
                        <TextBlock Text="{Binding CurrentAddress}" Foreground="#4EC9B0" FontFamily="Consolas" FontSize="12" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Search -->
        <Border DockPanel.Dock="Top" Padding="4,2" Background="#252526">
            <TextBox Text="{Binding SearchQuery}" Watermark="Search fields..."
                     FontSize="12" />
        </Border>

        <!-- Status bar (docked bottom — must come before fill element) -->
        <Border DockPanel.Dock="Bottom" Padding="6,2" Background="#007ACC"
                IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="11" />
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="6,2" Background="#D32F2F"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="White" FontSize="11" />
        </Border>

        <!-- Fields DataGrid -->
        <DataGrid x:Name="FieldsGrid"
                  x:CompileBindings="False"
                  ItemsSource="{Binding Fields}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  HorizontalScrollBarVisibility="Auto"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="#1E1E1E"
                  RowBackground="#1E1E1E"
                  Foreground="#D4D4D4"
                  FontFamily="Consolas"
                  FontSize="12">
            <!-- ContextMenu wired in code-behind for AOT compatibility -->
            <DataGrid.Columns>
                <DataGridTextColumn Header="Offs" Binding="{Binding OffsetDisplay}" Width="70" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" />
                <DataGridTemplateColumn Header="Value" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Panel>
                                <!-- Container fields: clickable to drill down -->
                                <Button Content="{Binding Value}"
                                        Command="{Binding $parent[UserControl].DataContext.NavigateContainerCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding IsContainer}"
                                        Padding="2,0"
                                        Margin="0"
                                        Background="Transparent"
                                        Foreground="#DCDCAA"
                                        Cursor="Hand"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center" />
                                <!-- Non-container fields: plain text -->
                                <TextBlock Text="{Binding Value}"
                                           IsVisible="{Binding !IsContainer}"
                                           VerticalAlignment="Center"
                                           Padding="2,0" />
                            </Panel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Hex" Binding="{Binding Hex}" Width="120" />
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="140" />
                <DataGridTemplateColumn Header="Ptr" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding PtrValue}"
                                    Command="{Binding $parent[UserControl].DataContext.NavigatePointerCommand}"
                                    CommandParameter="{Binding}"
                                    IsVisible="{Binding PtrValue, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Padding="2,0"
                                    Margin="0"
                                    Background="Transparent"
                                    Foreground="#4EC9B0"
                                    Cursor="Hand"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
