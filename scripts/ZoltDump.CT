<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries>
    <CheatEntry>
      <ID>100</ID>
      <Description>"=== Zolt-Dump v1.0 — Godot Engine Dumper ==="</Description>
      <Color>00BB5E</Color>
      <GroupHeader>1</GroupHeader>
    </CheatEntry>
    <CheatEntry>
      <ID>102</ID>
      <Description>"init &lt;== enable after process attached"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- ============================================================
-- Zolt-Dump — Table Script
-- Auto-runs when this CT is opened in Cheat Engine.
-- ============================================================

-- Auto-detect DLL path by searching candidate directories.
local _candidates = {}
local _openPath = ""
pcall(function() _openPath = getMainForm().OpenDialog1.FileName or "" end)
local _savePath = getMainForm().SaveDialog1.FileName or ""

-- 1. CE dialog paths (may be stale — check file existence below)
local _openDir = extractFilePath(_openPath)
local _saveDir = extractFilePath(_savePath)
if _openDir and _openDir ~= "" then table.insert(_candidates, _openDir) end
if _saveDir and _saveDir ~= "" and _saveDir ~= _openDir then table.insert(_candidates, _saveDir) end

-- 2. TrainerOrigin (only set in trainer mode)
if TrainerOrigin and TrainerOrigin ~= "" then
    local _trainerDir = extractFilePath(TrainerOrigin)
    if _trainerDir and _trainerDir ~= "" then table.insert(_candidates, _trainerDir) end
end

-- 3. CE install directory
local _ceDir = getCheatEngineDir() or ""
if _ceDir ~= "" then table.insert(_candidates, _ceDir) end

-- 4. Known app data location
local _appData = os.getenv("LOCALAPPDATA") or ""
if _appData ~= "" then table.insert(_candidates, _appData .. "\\ZoltDump\\") end

-- Find first directory containing ZoltDumper.dll
DLL_PATH = nil
local _dllFoundIn = nil
for _, dir in ipairs(_candidates) do
    local test = dir .. "ZoltDumper.dll"
    local f = io.open(test, "rb")
    if f then
        f:close()
        DLL_PATH = test
        _dllFoundIn = dir
        break
    end
end

if not DLL_PATH then
    print("[Zolt-Dump] ERROR: ZoltDumper.dll not found in any candidate directory!")
    for i, dir in ipairs(_candidates) do
        print(string.format("[Zolt-Dump]   candidate %d: '%s'", i, dir))
    end
    local msg = "Zolt-Dump Error:\n\nZoltDumper.dll not found!\n\nSearched locations:\n"
    for i, dir in ipairs(_candidates) do
        msg = msg .. "  " .. i .. ". " .. dir .. "\n"
    end
    msg = msg .. "\nPlease place ZoltDumper.dll in the same folder as this CT file."
    showMessage(msg)
    return
end

-- Diagnostic: show search results
print(string.format("[Zolt-Dump] OpenDialog1 = '%s'", _openPath))
print(string.format("[Zolt-Dump] SaveDialog1 = '%s'", _savePath))
if _dllFoundIn then
    print(string.format("[Zolt-Dump] DLL found in: '%s'", _dllFoundIn))
end

-- ============================================================
-- File Logging (to %LOCALAPPDATA%\ZoltDump\Logs)
-- ============================================================

local _logHandle = nil

local function zolt_logInit()
    local localAppData = os.getenv("LOCALAPPDATA") or ""
    if localAppData == "" then return end

    local logDir = localAppData .. "\\ZoltDump\\Logs\\"
    os.execute('mkdir "' .. logDir .. '" 2&gt;nul')

    local logFile = logDir .. "ZoltDumper-lua.log"
    local h = io.open(logFile, "w")
    if h then
        _logHandle = h
        h:write(string.format("[%s] [Zolt-Dump] Log file opened: %s\n", os.date("%H:%M:%S"), logFile))
        h:flush()
    end
end

zolt_logInit()

-- ============================================================
-- Logging helpers (CE console + file)
-- ============================================================

function zolt_log(fmt, ...)
    local msg = string.format("[%s] [Zolt-Dump] " .. fmt, os.date("%H:%M:%S"), ...)
    print(msg)
    if _logHandle then
        _logHandle:write(msg .. "\n")
        _logHandle:flush()
    end
end

function zolt_logError(fmt, ...)
    local msg = string.format("[%s] [Zolt-Dump ERROR] " .. fmt, os.date("%H:%M:%S"), ...)
    print(msg)
    if _logHandle then
        _logHandle:write(msg .. "\n")
        _logHandle:flush()
    end
end

-- ============================================================
-- DLL call wrapper  (executeCodeEx: retType 0=void, 1=integer)
-- ============================================================

function zolt_callDLL(funcName, retType, ...)
    local fn = getAddress(funcName)
    if fn == nil or fn == 0 then
        zolt_logError("Export not found: %s  (DLL not injected?)", funcName)
        return nil
    end

    local ceRetType = (retType == "void") and 0 or 1
    local result = executeCodeEx(ceRetType, fn, ...)

    if result == nil then
        zolt_logError("executeCodeEx returned nil for %s — process alive?", funcName)
        return nil
    end

    if retType == "bool" then return result ~= 0 end
    return result
end

-- ============================================================
-- zolt_inject()  —  called from [ENABLE] of the inject entry
-- ============================================================

function zolt_inject()
    zolt_log("Starting Zolt-Dump...")
    zolt_log("DLL path: %s", DLL_PATH)

    -- 0. Pre-check: verify CE has attached to a game process.
    local pid = getOpenedProcessID()
    if pid == 0 then
        zolt_logError("No game process attached! Open a game process in CE first (File &gt; Open Process).")
        showMessage("Zolt-Dump Error:\n\nNo game process is attached to Cheat Engine.\n\nPlease attach CE to a running Godot game first:\n  File &gt; Open Process (or click the process icon)")
        return
    end
    zolt_log("Target process PID: %d", pid)

    -- 1. Inject DLL into the target process.
    -- The DLL auto-start thread handles Zolt_AutoStart (AOBScan + pipe server)
    -- internally via DllMain — no executeCodeEx calls needed.
    if not injectDLL(DLL_PATH) then
        zolt_logError("injectDLL failed! DLL_PATH: %s", DLL_PATH)
        showMessage("Zolt-Dump Error:\n\ninjectDLL failed.\n\nPossible causes:\n1. CE is not attached to a game process\n2. DLL file not found: " .. DLL_PATH .. "\n3. Anti-cheat blocking injection")
        return
    end
    zolt_log("DLL injected OK")

    -- 2. Wait for auto-start thread to complete.
    -- Timeline: 1s thread delay + ~2-8s AOB scan + pipe server start.
    local WAIT_SEC = 15
    zolt_log("Waiting %d sec for ObjectDB/ClassDB/SceneTree scan + Pipe Server...", WAIT_SEC)
    for i = WAIT_SEC, 1, -1 do
        sleep(1000)
        zolt_log("  ... %d sec remaining", i - 1)
    end

    zolt_log("=========================================")
    zolt_log("DLL auto-start complete (or failed — check DLL log).")
    zolt_log("Pipe: \\\\.\\pipe\\ZoltDumpBfx")
    zolt_log("Launch ZoltDumpUI.exe and click Connect.")
    zolt_log("DLL log: %%LOCALAPPDATA%%\\ZoltDump\\Logs")
    zolt_log("=========================================")
end

-- ============================================================
-- zolt_shutdown()  —  called from [DISABLE] of the inject entry
-- ============================================================

function zolt_shutdown()
    zolt_callDLL("Zolt_StopPipeServer", "void")
    zolt_callDLL("Zolt_Shutdown",       "void")
    zolt_log("Zolt-Dump stopped.")
    if _logHandle then
        _logHandle:close()
        _logHandle = nil
    end
end

-- ============================================================
-- Highlight custom functions in CE's Lua syntax highlighter
-- ============================================================

registerLuaFunctionHighlight('zolt_inject')
registerLuaFunctionHighlight('zolt_shutdown')
registerLuaFunctionHighlight('zolt_callDLL')
registerLuaFunctionHighlight('zolt_log')
registerLuaFunctionHighlight('zolt_logError')

-- Print startup hint
zolt_log("Table loaded. Check [Inject DLL + Start Pipe Server] to begin.")
zolt_log("DLL_PATH = %s", DLL_PATH)



[DISABLE]
{$asm}
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>1</ID>
          <Description>"Inject DLL + Start Pipe Server"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end

zolt_inject()

[DISABLE]
{$lua}
if syntaxcheck then return end

zolt_shutdown()
</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
